{
  "name": "trackify-frontend",
  "private": true,
  "workspaces": [
    "packages/trackify-shared",
    "master-app",
    "tenant-app"
  ],
  "scripts": {
    "dev": "npm run dev:tenant",
    "start": "npm run dev:tenant",
    "dev:tenant": "npm run dev -w tenant-app",
    "dev:master": "npm run dev -w master-app",
    "build": "npm run build -w tenant-app && npm run build -w master-app",
    "lint": "npm run lint -w tenant-app && npm run lint -w master-app",
    "test": "npm run test -w tenant-app && npm run test -w master-app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node ../scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
