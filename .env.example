# Copy this file to `.env` in the project root and set real values.
# Never commit `.env` to version control.
# See Docs/ENVIRONMENT.md for full reference.

# JWT signing secret — plain text (32+ chars) or Base64 from: openssl rand -base64 32
# Must match across all backend services.
JWT_SECRET=trackify-local-dev-jwt-secret-min-32-chars!

# Internal service-to-service API key (tenant-service -> project-service notifications)
INTERNAL_API_KEY=change-me-internal-api-key

# MySQL (local development)
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Gateway rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120

# Attachment storage (project-service): local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_BYTES=10485760

# S3 (when STORAGE_PROVIDER=s3)
S3_BUCKET=trackify-attachments
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_KEY_PREFIX=attachments

# SMTP (notification-service)
# If MAIL_USERNAME/MAIL_PASSWORD are unset, emails are logged to the console locally.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password-here
MAIL_FROM=your-email@example.com

# Frontend API URL (Vite dev server)
VITE_API_BASE_URL=http://localhost:8080

# Local dev only — optional fixed password when provisioning tenants (screenshot/README capture)
# TRACKIFY_DEV_FIXED_ADMIN_PASSWORD=admin123
