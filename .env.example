# Copy this file to `.env` in the project root and set real values.
# Never commit `.env` to version control.

# JWT signing secret (min 32 characters; must match across all backend services)
JWT_SECRET=change-me-use-openssl-rand-base64-32

# MySQL (docker-compose local dev)
MYSQL_ROOT_PASSWORD=root
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# SMTP (notification-service) — optional for local dev without email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password-here

# Frontend API URL (Vite — used at build time for Docker images)
# Local dev: http://localhost:8080
# Docker/nginx: http://api.trackify.com or http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
