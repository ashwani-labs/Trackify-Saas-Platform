# Copy to `.env` in the repository root. Never commit `.env`.
# Backend services load this file automatically (see trackify-env-imports.yml).
# Frontend Vite apps read VITE_* vars from this same root via envDir.
# Full setup: docs/SETUP.md

# --- Required ---

# JWT signing secret — plain text (32+ chars) or Base64: openssl rand -base64 32
# Must be identical across gateway and all backend services.
JWT_SECRET=trackify-local-dev-jwt-secret-min-32-chars!

# Service-to-service key (tenant-service → project-service internal notifications)
INTERNAL_API_KEY=change-me-internal-api-key

# MySQL credentials (master DB + tenant provisioning)
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Frontend → API gateway
VITE_API_BASE_URL=http://localhost:8080

# --- Gateway ---

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120

# --- Attachments (project-service) ---

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_BYTES=8388608

# When STORAGE_PROVIDER=s3
S3_BUCKET=trackify-attachments
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_KEY_PREFIX=attachments

# --- Email (notification-service) ---
# Leave MAIL_USERNAME / MAIL_PASSWORD empty to log emails to the console locally.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@trackify.local

# --- Production overrides (optional locally) ---

# SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/trackify_master
# SERVICES_AUTH_URL=http://auth-service:8081
# SERVICES_TENANT_URL=http://tenant-service:8082
# SERVICES_PROJECT_URL=http://project-service:8083
# SERVICES_NOTIFICATION_URL=http://notification-service:8084
# TENANT_DATASOURCE_DEFAULT_HOST=db
# TENANT_APP_URL_PATTERN=https://%s.example.com

# --- Local / demo only ---

# Fixed password for newly provisioned tenant admins (screenshots, demos)
# TRACKIFY_DEV_FIXED_ADMIN_PASSWORD=admin123

# Seed password for master@trackify.com on first auth-service boot (local profile)
TRACKIFY_DEV_MASTER_PASSWORD=admin123

# Tenant app port used when building workspace URLs in the UI
# VITE_TENANT_APP_PORT=5174
