# Copy this file to `.env` in the project root and set real values.
# Never commit `.env` to version control.
# See documents/DOCKER_PRODUCTION.md for production guidance.

# JWT signing secret (min 32 characters; must match across all backend services)
JWT_SECRET=change-me-use-openssl-rand-base64-32

# Internal service-to-service API key (tenant-service -> project-service notifications)
INTERNAL_API_KEY=change-me-internal-api-key

# MySQL (docker-compose local dev)
MYSQL_ROOT_PASSWORD=root
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Gateway rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120

# Attachment storage (project-service): local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_BYTES=10485760

# S3 / MinIO (when STORAGE_PROVIDER=s3)
S3_BUCKET=trackify-attachments
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_KEY_PREFIX=attachments

# SMTP (notification-service) — optional for local dev without email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password-here

# Frontend API URL (Vite — used at build time for Docker images)
# Local dev: http://localhost:8080
# Docker/nginx: http://api.trackify.com or http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
